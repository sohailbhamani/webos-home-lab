From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: webos-home-lab
Date: Thu, 30 Oct 2026 00:00:00 +0000
Subject: [PATCH 7/7] step e: dark connection tiles

---
 .../Containers/Sub/MobileComponent.qml            | 15 ++++++++++-----
 1 file changed, 10 insertions(+), 5 deletions(-)

diff --git a/UserInterfaceLayer/Containers/Sub/MobileComponent.qml b/UserInterfaceLayer/Containers/Sub/MobileComponent.qml
index 96490c5..7c78a95 100755
--- a/UserInterfaceLayer/Containers/Sub/MobileComponent.qml
+++ b/UserInterfaceLayer/Containers/Sub/MobileComponent.qml
@@ -49,10 +49,11 @@ Selectable {
             if(entry) {
                 if(entry.detailType === "browser_guide") return "#333333";
                 else {
+                    // krieger: dark tiles
                     if(entry.activate === false || entry.activate === "inactive")
-                        return "#A6A6A6";
+                        return "#66151A24";
                     else
-                        return "#FFFFFF";
+                        return root.hasFocus ? "#3A4150" : "#CC151A24";
                 }
             } else {
                 return "transparent";
@@ -63,7 +64,7 @@ Selectable {
             if(entry.activate === false)
                 return "#26FFFFFF";
             else
-                return "#FFFFFF";
+                return root.hasFocus ? "#FFFFFF" : "#40FFFFFF"; // krieger: dark tiles
         }
         border.width: entry && entry.detailType && entry.detailType === "browser_guide" ? 0 : entry.activate === "inactive" ? 0 : styleSheet.getRValue(2)
     }
@@ -112,6 +113,8 @@ Selectable {
         Image {
 
             id: defaultImg
+            layer.enabled: !(entry && entry.type === "mobile") // krieger: light icons on dark tiles
+            layer.effect: ColorOverlay { color: "#E6E6E6" }
 
             width: styleSheet.getRValue(54)
             height: width
@@ -129,6 +132,8 @@ Selectable {
         Image {
 
             id: img
+            layer.enabled: !(entry && entry.type === "mobile") // krieger: light icons on dark tiles
+            layer.effect: ColorOverlay { color: "#E6E6E6" }
 
             width: styleSheet.getRValue(54)
             height: width
@@ -221,7 +226,7 @@ Selectable {
                         if(entry.activate === false || entry.activate === "inactive")
                             return "#808080";
                         else
-                            return "#000000";
+                            return "#F2F2F2"; // krieger: dark tiles
                     }
                 }
             }
@@ -249,7 +254,7 @@ Selectable {
                     if(entry.activate === false || entry.activate === "inactive")
                         return "#808080";
                     else
-                        return "#000000";
+                        return "#F2F2F2"; // krieger: dark tiles
                 }
             }
         }
