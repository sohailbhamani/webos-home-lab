-                    self._initByServerData(systemProperties.shelfListDataSDX);
+                    self._initByDefault(); // krieger: default shelves, not LG server list
                 } else {
                     self._initByDefault();
                 }
@@ -39,7 +39,7 @@ class ShelfList {
