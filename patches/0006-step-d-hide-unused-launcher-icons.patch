From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: webos-home-lab
Date: Thu, 30 Oct 2026 00:00:00 +0000
Subject: [PATCH 6/7] step d: hide unused launcher icons

---
 Configurations/SystemServiceResponseProcessors.js | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/Configurations/SystemServiceResponseProcessors.js b/Configurations/SystemServiceResponseProcessors.js
index 0c8c53a..9dbaf39 100755
--- a/Configurations/SystemServiceResponseProcessors.js
+++ b/Configurations/SystemServiceResponseProcessors.js
@@ -54,10 +54,12 @@ function Processor() {
                                 systemProperties.isResetCase = false;
                             }
 
-                            systemProperties.launchPoints = response.launchPoints;
+                            // krieger: hide launcher icons Riz never uses (apps stay installed)
+                            var kriegerHidden = ["com.webos.app.lgchannels", "com.webos.app.homeconnect", "com.webos.app.sportsteamsettings", "com.webos.app.browser", "com.webos.app.mediadiscovery", "amazon.alexa.view", "com.webos.app.livepick-full", "com.webos.app.roomconnect", "org.webosbrew.vncserver"];
+                            systemProperties.launchPoints = response.launchPoints.filter(function(lp) { return kriegerHidden.indexOf(lp.id) < 0; });
                         }
 
-                        if(response.change !== undefined) {
+                        if(response.change !== undefined && ["com.webos.app.lgchannels", "com.webos.app.homeconnect", "com.webos.app.sportsteamsettings", "com.webos.app.browser", "com.webos.app.mediadiscovery", "amazon.alexa.view", "com.webos.app.livepick-full", "com.webos.app.roomconnect", "org.webosbrew.vncserver"].indexOf(response.id) < 0) {
                             systemProperties.updatedAppObject = response;
                         }
                     },
